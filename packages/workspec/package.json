{
  "name": "workspec",
  "private": false,
  "version": "1.1.1",
  "description": "WorkSpec 2.1 runtime, validator and CLI.",
  "license": "AGPL-3.0",
  "main": "index.js",
  "bin": {
    "workspec": "bin/workspec.js"
  },
  "scripts": {
    "check:sync": "node scripts/check-sync.js",
    "sync:web": "node scripts/sync-web-assets.js",
    "test:integration": "node scripts/sync-web-assets.js && node scripts/test-playground-integration.js",
    "test": "node scripts/self-test.js && node --test scripts/workspec-runtime-2.1.test.js scripts/reliability-corpus.test.js && npm run test:integration"
  },
  "files": [
    "bin/",
    "index.js",
    "custom-validation-runner.js",
    "custom-validation-worker.js",
    "workspec-validator.js",
    "workspec-runtime.js",
    "workspec-migrate-v1-to-v2.js",
    "state-visuals.js",
    "examples/",
    "reliability/",
    "v2.1.schema.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
